{
  "name": "pptx2html",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Convert PowerPoint (PPTX) files to HTML5",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run test:e2e --workspace=apps/pages",
    "typecheck": "tsc -b"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.11.1",
    "html-webpack-plugin": "^5.6.8",
    "prettier": "^3.9.6",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "webpack": "^5.109.0",
    "webpack-cli": "^7.2.1",
    "webpack-dev-server": "^6.0.0"
  },
  "license": "UNLICENSED"
}
